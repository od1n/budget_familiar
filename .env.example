# Copia este archivo como .env y completa los valores reales.
# NUNCA subas .env a control de versiones.

# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui

# Anthropic (Claude API) — solo usado desde Edge Functions, no en el cliente
ANTHROPIC_API_KEY=sk-ant-...

# NewsAPI
NEWS_API_KEY=tu_news_api_key

# ExchangeRate-API
EXCHANGE_RATE_API_KEY=tu_exchange_rate_key

# Firebase (completar con google-services.json / GoogleService-Info.plist también)
# Los valores de Firebase van en los archivos nativos de configuración, no aquí.
